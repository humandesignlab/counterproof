# Counterproof environment configuration (example).
# Copy to .env and fill in. Never commit a real .env. Never log these values.
#
# v1 is synthetic-data-only and stateless. These keys exist so the model
# provider and its data-handling posture are explicit and configurable.
# Default posture: no training on input. Sensitive data is never sent to an
# external service silently.

# Model provider selection and credentials.
COUNTERPROOF_MODEL_PROVIDER=anthropic
# Credential is read from the environment only, never hardcoded or committed.
ANTHROPIC_API_KEY=

# Pinned model and prompt versions for reproducibility (recorded in reports).
COUNTERPROOF_MODEL_VERSION=
COUNTERPROOF_PROMPT_VERSION=

# Provider data handling. Default to no training on submitted input.
COUNTERPROOF_PROVIDER_ALLOW_TRAINING=false
